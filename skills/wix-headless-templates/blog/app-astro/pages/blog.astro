---
// Blog index — data fetched SERVER-SIDE (SEO) and handed to the island as DTO props.
// Keep this frontmatter; swap the island import to YOUR feed component. The category pills link
// to the category pages (/blog/category/<slug>) so every filter has a URL; pass no `categoryHref`
// for client-side filtering instead.
import SiteLayout from "../layouts/SiteLayout.astro";
import BlogFeedView from "../components/blog/BlogFeedView";
import { categoryPath, fetchPosts } from "../wix/blog/posts";
import { fetchBlogCategories, fetchBlogTags } from "../wix/blog/taxonomy";
import type { BlogCategory, BlogTag, PostPage } from "../wix/blog/types";
import { readFailureResponse } from "../wix/blog/errors";

let page: PostPage;
let categories: BlogCategory[];
let tags: BlogTag[];
try {
  [page, categories, tags] = await Promise.all([fetchPosts(), fetchBlogCategories(), fetchBlogTags()]);
} catch (e) {
  return readFailureResponse(e, "The blog feed");
}
---

<SiteLayout title="Blog">
  <h1 class="mb-8 text-2xl font-semibold tracking-tight">Blog</h1>
  <BlogFeedView
    client:load
    initialPage={page}
    initialCategories={categories}
    initialTags={tags}
    categoryHref={categoryPath}
  />
</SiteLayout>
