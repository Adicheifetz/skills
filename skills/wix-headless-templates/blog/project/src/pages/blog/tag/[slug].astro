---
// Tag page — the feed filtered to one tag, with the tag's label as its header (a tag carries no
// description or cover). No SEO item type exists for tags (the enum has BLOG_POST and BLOG_CATEGORY
// only) and Wix's own sitemap lists no tag pages, so this page is a plain page: the layout's
// title comes from the tag's label. Keep the frontmatter; restyle the template. The first page is
// fetched SERVER-SIDE with the tag filter and seeded together with the filter id. An unknown slug is
// a real 404 (Wix's router answers 200 + empty feed; on a headless site that page does not exist).
import SiteLayout from "../../../layouts/SiteLayout.astro";
import BlogFeedView from "../../../components/blog/BlogFeedView";
import { categoryPath, fetchPosts } from "../../../wix/blog/posts";
import { fetchBlogCategories, fetchBlogTags, fetchTagBySlug } from "../../../wix/blog/taxonomy";
import type { BlogCategory, BlogTag, PostPage } from "../../../wix/blog/types";
import { readFailureResponse } from "../../../wix/blog/errors";

const slug = Astro.params.slug!;

let tag: BlogTag;
let page: PostPage;
let categories: BlogCategory[];
let tags: BlogTag[];
try {
  [tag, categories, tags] = await Promise.all([fetchTagBySlug(slug), fetchBlogCategories(), fetchBlogTags()]);
  page = await fetchPosts({ tagId: tag.id });
} catch (e) {
  return readFailureResponse(e, `Tag page "${slug}"`);
}
---

<SiteLayout title={tag.label}>
  <header class="mb-10">
    <p class="eyebrow">Tag</p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight">{tag.label}</h1>
  </header>

  <BlogFeedView
    client:load
    initialPage={page}
    initialTagId={tag.id}
    initialCategories={categories}
    initialTags={tags}
    categoryHref={categoryPath}
    emptyMessage="No posts with this tag yet."
  />
</SiteLayout>
